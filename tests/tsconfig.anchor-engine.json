{
  "//": "Compile the ReviewService integration suites as CommonJS through the same path mapping used for the anchor engine (@getpaseo/plugin resolves through its exports map, which legacy node10 resolution cannot read for CJS emit).",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "ES2020",
    "lib": ["ES2024"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "outDir": "../node_modules/.cache/review-deck-anchor-tests",
    "baseUrl": "..",
    "paths": {
      "@getpaseo/plugin": ["node_modules/@getpaseo/plugin/dist/index.d.ts"],
      "@getpaseo/plugin/server": ["node_modules/@getpaseo/plugin/dist/server/index.d.ts"],
      "@getpaseo/plugin/client": ["node_modules/@getpaseo/plugin/dist/client/index.d.ts"]
    }
  },
  "files": [
    "../server/ReviewService.ts",
    "anchor-engine.test.ts",
    "ai-review-service.test.ts"
  ]
}
